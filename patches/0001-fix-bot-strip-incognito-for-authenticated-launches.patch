From 237d3cdc89b3033e2875793af8432bb90f09b50d Mon Sep 17 00:00:00 2001
From: igordev23 <igor.dev89898@gmail.com>
Date: Fri, 2 Oct 2026 22:11:35 -0300
Subject: [PATCH] fix(bot): strip --incognito for authenticated launches
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

An authenticated bot restores a persistent Chromium profile (its signed-in
Google cookies) from S3, but getJoinBrowserArgs() carries --incognito for the
guest lane. Combined at the launch site, --incognito starts a fresh in-memory
session that ignores the restored profile: Meet sees a signed-out guest and the
join guard raises AuthSessionError (completion_reason: auth_session_missing).

Fixed at the point of introduction — the launch composition in capture-bridge,
the only place that knows the launch is authenticated; the join module cannot.
Strip --incognito for authenticated launches only; a guest bot has no profile
to protect and keeps it.
---
 core/meetings/services/bot/src/capture-bridge.ts | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/core/meetings/services/bot/src/capture-bridge.ts b/core/meetings/services/bot/src/capture-bridge.ts
index 3b47fcb..31d8da8 100644
--- a/core/meetings/services/bot/src/capture-bridge.ts
+++ b/core/meetings/services/bot/src/capture-bridge.ts
@@ -592,7 +592,17 @@ export async function launchBrowser(inv: Invocation): Promise<BrowserSession> {
   // getAuthenticatedBrowserArgs() is the minimal clean set remote-browser uses for signed-in
   // joins; getJoinBrowserArgs() adds the fake-device / autoplay flags the join lane needs. The
   // join args win on conflict (later wins in Chromium arg parsing).
-  const args = [...getAuthenticatedBrowserArgs(), ...getJoinBrowserArgs()];
+  //
+  // An authenticated launch restores a persistent Chromium profile (its signed-in cookies) from S3
+  // just above; --incognito, which getJoinBrowserArgs() carries for the guest lane, starts a fresh
+  // in-memory session that ignores that profile — Meet then sees a signed-out guest and the join
+  // guard raises AuthSessionError. The join module can't reconcile this: only here is it known that
+  // this is an authenticated launch. So strip --incognito for authenticated launches only; a guest
+  // bot has no profile to protect and keeps it.
+  const joinArgs = inv.authenticated
+    ? getJoinBrowserArgs().filter((a) => a !== "--incognito" && !a.startsWith("--incognito="))
+    : getJoinBrowserArgs();
+  const args = [...getAuthenticatedBrowserArgs(), ...joinArgs];
   const { context, page } = await launchPersistentBrowser({ dataDir, args });
 
   // Voice-agent gate the page reads to decide whether to keep the mic hot (production parity).
